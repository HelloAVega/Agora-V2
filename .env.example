# Environment Configuration
NODE_ENV=development

# Server
PORT=3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agora
SQLITE_STORAGE=./server/data/agora.sqlite

# Docker development uses DATABASE_URL pointing to the postgres service.
# Local non-Docker runs can fall back to SQLITE_STORAGE.
# Heroku should always use DATABASE_URL (PostgreSQL) for persistence.

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production

# Frontend
FRONTEND_URL=http://localhost:5173

# Third-party APIs
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
